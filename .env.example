# zcashNG operator environment.
#
# `setup.sh` copies this to `.env` on first run. Every variable has a sane
# mainnet default in docker-compose.yml; this file is for overrides only.

# Run the monitoring stack alongside the node. Comment out for a bare node.
COMPOSE_PROFILES=monitoring

# -----------------------------------------------------------------------------
# Storage. ZCASHNG_DATA_DIR is the one variable that controls where every
# stateful service writes — chain state, wallet DB, Prometheus TSDB, Grafana
# DB, Alertmanager state. Point it at the disk you want to keep / back up.
# -----------------------------------------------------------------------------
# ZCASHNG_DATA_DIR=./data

# -----------------------------------------------------------------------------
# Network exposure. All UIs and the RPC bind to loopback by default. Widen
# only if you're fronting the stack with a reverse proxy or trust the network.
# Zebra's p2p port (8233) is always published on all interfaces — that's how
# inbound peers reach the node.
# -----------------------------------------------------------------------------
# ZCASHNG_BIND_ADDR=127.0.0.1

# -----------------------------------------------------------------------------
# Optional HTTP Basic auth on the host-facing JSON-RPC port. If both vars are
# set, the rpc-router rejects anonymous requests with 401. Default is anonymous
# (safe because of the loopback bind above).
# -----------------------------------------------------------------------------
# ZCASHNG_RPC_USER=
# ZCASHNG_RPC_PASSWORD=

# -----------------------------------------------------------------------------
# Image pins. zcashNG tracks `latest` for the Zcash stack so operators stay
# current via `docker compose pull`. Pin here if you want change control.
# -----------------------------------------------------------------------------
# ZCASHNG_ZEBRA_IMAGE=zfnd/zebra:5.0.0
# ZCASHNG_ZALLET_IMAGE=electriccoinco/zallet:v0.1.0-alpha.3
# ZCASHNG_RPC_ROUTER_IMAGE=ghcr.io/alchemydc/zcashng-rpc-router:latest

# Zallet's published image is currently amd64-only. On arm64 hosts Docker
# uses emulation (slow but functional). Override if a multi-arch tag ships.
# ZCASHNG_ZALLET_PLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# Ports (host side). The container-side ports are fixed; these are what the
# operator binds on the host. Change if they collide with something else
# running on the box.
# -----------------------------------------------------------------------------
# ZCASHNG_P2P_PORT=8233          # Zebra p2p (published on all interfaces)
# ZCASHNG_RPC_PORT=8232          # rpc-router host-facing port
# ZCASHNG_HEALTH_PORT=8080       # Zebra /ready endpoint
# ZCASHNG_PROMETHEUS_PORT=9094
# ZCASHNG_GRAFANA_PORT=3000
# ZCASHNG_ALERTMANAGER_PORT=9093

# -----------------------------------------------------------------------------
# Grafana admin password. CHANGE THIS before widening ZCASHNG_BIND_ADDR.
# -----------------------------------------------------------------------------
# ZCASHNG_GRAFANA_PASSWORD=admin

# -----------------------------------------------------------------------------
# Log levels (Rust `tracing` filter syntax).
# -----------------------------------------------------------------------------
# ZCASHNG_ZEBRA_RUST_LOG=info
# ZCASHNG_ZALLET_RUST_LOG=info,hyper_util=warn,reqwest=warn
# ZCASHNG_RPC_ROUTER_RUST_LOG=info
# ZEBRA_TRACING__FILTER=info

# -----------------------------------------------------------------------------
# Zebra health thresholds. Defaults are fine for production; tune for slow
# initial sync or low-peer environments.
# -----------------------------------------------------------------------------
# ZEBRA_HEALTH__MIN_CONNECTED_PEERS=1
# ZEBRA_HEALTH__READY_MAX_BLOCKS_BEHIND=2
