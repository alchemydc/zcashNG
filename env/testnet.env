# Testnet env file.
#   docker compose --env-file env/testnet.env up -d
#
# Loopback ports use a +10000 offset relative to mainnet defaults so testnet
# can coexist with a mainnet stack on the same host. Zebra's testnet p2p port
# (18233) and the COMPOSE_PROJECT_NAME / data dir already differ from mainnet.

COMPOSE_PROJECT_NAME=zcashng-testnet
COMPOSE_PROFILES=monitoring

ZCASHNG_NETWORK=Testnet
ZCASHNG_DATA_DIR=./data-testnet

# Zebra testnet p2p port (canonical) — published on all interfaces.
ZCASHNG_P2P_PORT=18233

# Loopback-bound ports offset +10000 to avoid collision with mainnet.
ZCASHNG_RPC_PORT=18232
ZCASHNG_HEALTH_PORT=18080
ZCASHNG_PROMETHEUS_PORT=19094
ZCASHNG_GRAFANA_PORT=13000
ZCASHNG_ALERTMANAGER_PORT=19093
