# Regtest env file.
#   docker compose --env-file env/regtest.env up -d
#   ./scripts/regtest-mine.sh
#
# Regtest has no peers, so the health endpoint's "min connected peers" check
# is disabled. The extra-config mount path swaps in a TOML carrying activation
# heights for every network upgrade.

COMPOSE_PROJECT_NAME=zcashng-regtest
COMPOSE_PROFILES=monitoring

ZCASHNG_NETWORK=Regtest
ZCASHNG_DATA_DIR=./data-regtest

# Regtest p2p port is unused (no peers); keep set for compose-syntax sanity.
ZCASHNG_P2P_PORT=18233

# Loopback-bound ports offset +20000 to coexist with mainnet AND testnet.
ZCASHNG_RPC_PORT=28232
ZCASHNG_HEALTH_PORT=28080
ZCASHNG_PROMETHEUS_PORT=29094
ZCASHNG_GRAFANA_PORT=23000
ZCASHNG_ALERTMANAGER_PORT=29093

# Mount the regtest TOML (activation heights) at /etc/zebra/zebrad.toml.
ZCASHNG_ZEBRA_EXTRA_CONFIG=./config/zebra.regtest.toml

# Use the regtest Zallet config (no Zebra DNS port change needed; we use 8232
# internally everywhere).
ZCASHNG_ZALLET_CONFIG=./config/zallet.regtest.toml

# Regtest has no peers — relax the readiness gate.
ZEBRA_HEALTH__MIN_CONNECTED_PEERS=0
ZEBRA_HEALTH__ENFORCE_ON_TEST_NETWORKS=false
