# Zallet configuration: Mainnet / Testnet.
#
# Zallet embeds Zaino's indexer libraries and dials Zebra's JSON-RPC endpoint
# directly. The service DNS name `zebra` resolves inside the zcashng-net
# Docker network.
#
# This file is a template. setup.sh copies it to ./config/zallet.toml; the
# active copy is gitignored so an operator can edit freely without conflict.
#
# For all available options run inside the zallet image:
#   docker run --rm electriccoinco/zallet example-config \
#     --this-is-alpha-code-and-you-will-need-to-recreate-the-example-later \
#     -o /tmp/out.toml

[builder]

[builder.limits]

[consensus]
# For testnet, change to "test".
network = "main"

[database]

[external]

[features]
as_of_version = "0.1.0-alpha.3"

[features.deprecated]

[features.experimental]

[indexer]
# Zebra's container-side RPC port is fixed at 8232 across all networks in zcashNG.
validator_address = "zebra:8232"

[keystore]
# Age-encrypted identity for wallet secrets; generated by setup.sh.
encryption_identity = "/etc/zallet/identity.txt"

[note_management]

[rpc]
# Listen on the internal Docker network only (no auth). The host-facing
# JSON-RPC port is the rpc-router on 8232, not Zallet directly.
bind = ["0.0.0.0:28232"]
timeout = 30
